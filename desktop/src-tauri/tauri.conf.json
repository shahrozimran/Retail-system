{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Global Auto Parts",
  "version": "1.0.0",
  "identifier": "com.globalautoparts.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Global Auto Parts",
        "width": 1360,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#000000",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'",
      "capabilities": [
        "main-window"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Global Auto Parts",
    "shortDescription": "Inventory, production, sales and customer accounts",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Global Auto Parts"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyOUQ4OTc3Njk0NTA4REQKUldUZENFVnBkNG1kUW9memdBcXZ6ZkFCSUwwbU1WeHlMQ3pyWHlMREExK3BJc1h4M1FMS3hjTGkK",
      "endpoints": [
        "https://github.com/shahrozimran/Retail-system/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
