# Server-only Supabase connection settings. The app does not use a service-role key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=https://retail-system-chi.vercel.app

# Public URL only; required when building Android. It points to the hosted Next server.
NEXT_PUBLIC_API_ORIGIN=https://retail-system-chi.vercel.app
NATIVE_ORIGINS=https://localhost,capacitor://localhost
